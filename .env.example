# Xeren Assistant Environment Configuration Example

# Gemini LLM API Key (Required for live reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Token (Optional for higher rate limits on read-only endpoints)
GITHUB_TOKEN=your_github_token_here

# App settings
XEREN_ENV=development
XEREN_WORKSPACE_ROOT=.
XEREN_LOG_LEVEL=INFO
XEREN_MAX_STEPS=10
XEREN_MAX_RETRIES=2
XEREN_TASK_TIMEOUT=60.0
XEREN_TOOL_TIMEOUT=10.0
